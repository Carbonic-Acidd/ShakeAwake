# --- Pico ---
WIFI_SSID=
WIFI_PASSWORD=
PICO_MQTT_USER=
PICO_MQTT_PASS=
MQTT_HOST=your-id.ala.us-east-1.emqxsl.com
MQTT_PORT=8883

# --- Server (Vercel). `make secrets` uploads these to the Vercel project (then redeploy) ---
# Upstash Redis's URL and token are added by Vercel itself (Storage tab), not from here.
# Calendar's private iCal (.ics) address. Google Calendar: Settings > your calendar >
# "Secret address in iCal format". webcal:// links work too.
# Optional: the website's Settings panel saves its own calendar link, which wins over this one.
ICS_URL=
# EMQX console > deployment Overview > REST API, e.g. https://your-id.ala.us-east-1.emqxsl.com:8443/api/v5
EMQX_API_URL=
# EMQX console > deployment Overview > Deployment API Key (App ID and App Secret)
EMQX_API_KEY=
EMQX_API_SECRET=
# Minutes before the day's first calendar event that the alarm goes off (default 60).
# Optional too: Settings on the website overrides it.
ALARM_OFFSET_MIN=60
# Names this Pico in the MQTT topics: shakeawake/<DEVICE_ID>/... (used by the Pico and the server)
DEVICE_ID=bed1
# The website's shared password (long passphrase, e.g. four or five random words).
# Typed into the page once per device; the server rejects /api calls without it.
# `make secrets` also sends it as CRON_SECRET, so Vercel's daily cron can call /api/cron.
APP_PASSWORD=
